# Dockerfile.backend
# Stage 1: cai dependencies production rieng de tan dung cache va giu image runtime gon hon.
FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./

RUN npm ci --omit=dev

# Stage 2: image runtime chi chua nhung gi can de chay API.
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules

COPY package.json ./

COPY backend ./backend

# Doi owner cua toan bo /app sang user node va group node.
RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["npm", "start"]
