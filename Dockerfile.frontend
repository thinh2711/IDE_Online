# Dockerfile.frontend
# Stage 1: dung Node.js de cai dependencies va build React/Vite thanh file static.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY frontend ./frontend

COPY vite.config.js ./

# Chay script build frontend, output cua Vite duoc cau hinh ra thu muc public.
RUN npm run build:web

# Stage 2: dung Nginx nhe hon Node.js de serve file static sau khi build.
FROM nginx:1.27-alpine AS runtime

# Ghi de config mac dinh cua Nginx bang config rieng cua project.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Copy ket qua build tu stage builder sang thu muc static ma Nginx serve.
COPY --from=builder /app/public /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
